from pathlib import Path
import pandas as pd
from scripts import defaults

try:
    import pyarrow.parquet as pq
    PYARROW_AVAILABLE = True
except ImportError:
    PYARROW_AVAILABLE = False

def retrieve_species_list(parquet_path: Path, csv_path: Path, default: list[str] = None) -> list[str]:
    """Read species from parquet (preferred) or CSV (fallback)."""
    try:
        if PYARROW_AVAILABLE and parquet_path.exists():
            table = pq.read_table(parquet_path, columns=['Species'])
            return table.to_pandas()['Species'].unique().tolist()
    except Exception:
        pass  # Fall back to CSV
    if csv_path.exists():
        return pd.read_csv(csv_path)["Species"].unique().tolist()
    return default if default else []

def retrieve_species_from_manifest(manifest_path: Path, default: list[str] = None) -> list[str]:
    """Read species list from simple text manifest file."""
    if manifest_path.exists():
        with open(manifest_path) as f:
            return [line.strip() for line in f if line.strip()]
    return default if default else []

def get_post_blast_species() -> list[str]:
    """
    Get species list for post-BLAST rules.

    If ORF analysis was run (flag file exists), use the species manifest.
    Otherwise, read species from blast.parquet/csv.
    """
    flag_file = defaults.PATH_DICT['ORF_OUTPUT_DIR'] / 'orf_analysis.flag'
    manifest_file = defaults.PATH_DICT['ORF_OUTPUT_DIR'] / 'species_manifest.txt'

    # Check if ORF analysis was run
    if flag_file.exists() and manifest_file.exists():
        species = retrieve_species_from_manifest(manifest_file)
        if species:
            return species

    # Fall back to blast.parquet/csv species list (parquet preferred)
    return retrieve_species_list(
        parquet_path=defaults.PATH_DICT['TABLE_OUTPUT_DIR'] / 'blast.parquet',
        csv_path=defaults.PATH_DICT['TABLE_OUTPUT_DIR'] / 'blast.csv',
        default=list(defaults.SPECIES)
    )

BLAST_DB_EXT = ['ndb', 'nhr', 'nin', 'not', 'nsq', 'ntf', 'nto']
SPECIES = defaults.SPECIES

# Species after BLAST (from blast.parquet or blast.csv)
# This is dynamically computed to handle both ORF and non-ORF modes
SPECIES_POST = get_post_blast_species()

configfile: str(defaults.CONFIG_FILE)

rule genome_downloader_setup:
    output:
        species=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}.fa')
    params:
        SPECIES_DB=str(defaults.PATH_DICT['SPECIES_DB']),
        DOWNLOAD_LOG=str(defaults.PATH_DICT['CONFIG_DIR'] / 'download.txt'),
        API_KEY=defaults.NCBI_API_TOKEN
    threads:
        workflow.cores / 3
    shell:
        '''
        export NCBI_API_KEY={params.API_KEY:q} && \
        bash scripts/genome_downloader.sh {wildcards.genome:q} {params.SPECIES_DB:q} {params.DOWNLOAD_LOG:q}
        '''

rule genome_downloader:
    input:
        species=expand(str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}.fa'), genome=defaults.SPECIES)
    priority: 100
    shell:
        """
        echo "Genome download completed for selected species"
        """

rule query_downloader_setup:
    output:
        species=str(defaults.QUERY_FILE)
    params:
        query_acc=defaults.QUERY_ACC,
        query_dir=str(defaults.PATH_DICT['FASTA_DIR']),
        download_log=str(defaults.PATH_DICT['CONFIG_DIR'] / 'download.txt'),
        entrez_email=defaults.ENTREZ_EMAIL
    shell:
        '''
        export ENTREZ_EMAIL={params.entrez_email:q} && \
        rm -f {params.query_dir:q}/* && \
        bash scripts/query_downloader.sh {params.query_acc:q} {params.query_dir:q} {params.download_log:q}
        '''

rule query_downloader:
    input:
        query_file=str(defaults.QUERY_FILE)
    priority: 100
    shell:
        """
        echo "Query protein download completed"
        """

rule pfam_hmm_downloader:
    output:
        md5=str(defaults.PATH_DICT['HMM_DB'] / 'md5sum.txt'),
        hmm=str(defaults.PATH_DICT['HMM_DB'] / 'Pfam-A.hmm')
    params:
        hmm_profile_dir=str(defaults.PATH_DICT['HMM_DB']),
        url='https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.gz',
        md5_url='https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/md5_checksums'
    threads:
        workflow.cores
    shell:
        """
        cd {params.hmm_profile_dir:q} && \
        wget -O {output.hmm:q}.gz {params.url:q} && \
        wget -O {output.md5:q} {params.md5_url:q} && \
        grep "Pfam-A.hmm.gz" {output.md5:q} | md5sum -c - && \
        echo "MD5 checksum for HMM profile is correct. Decompressing..." && \
        gunzip -d -f -v -k {params.hmm_profile_dir:q}/Pfam-A.hmm.gz
        """

# =============================================================================
# CDD Database Download Rules
# =============================================================================
# Downloads NCBI Conserved Domain Database for RPSBLAST and rpsbproc
# Sources:
#   - CDD BLAST database: https://ftp.ncbi.nih.gov/pub/mmdb/cdd/little_endian/
#   - rpsbproc data files: https://ftp.ncbi.nih.gov/pub/mmdb/cdd/
# =============================================================================

rule cdd_database_downloader:
    """Download and extract CDD database for RPSBLAST."""
    output:
        pal=str(defaults.PATH_DICT['RPS_DB']) + '.pal',
    params:
        cdd_dir=str(defaults.PATH_DICT['RPS_DB'].parent),
        url='https://ftp.ncbi.nih.gov/pub/mmdb/cdd/little_endian/Cdd_LE.tar.gz'
    threads:
        workflow.cores
    shell:
        """
        mkdir -p {params.cdd_dir:q} && \
        cd {params.cdd_dir:q} && \
        echo "Downloading CDD database (~1.5 GB)..." && \
        wget -q --show-progress -O Cdd_LE.tar.gz {params.url:q} && \
        echo "Extracting CDD database..." && \
        tar -xzf Cdd_LE.tar.gz && \
        rm -f Cdd_LE.tar.gz && \
        echo "CDD database download complete."
        """

rule rpsbproc_data_downloader:
    """Download rpsbproc annotation data files."""
    output:
        cddid=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'cddid.tbl'),
        cdtrack=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'cdtrack.txt'),
        family_links=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'family_superfamily_links'),
        cddannot=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'cddannot.dat'),
        cddannot_generic=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'cddannot_generic.dat'),
        bitscore=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'bitscore_specific.txt'),
    params:
        rpsbproc_dir=str(defaults.PATH_DICT['RPSBPROC_DB']),
        base_url='https://ftp.ncbi.nih.gov/pub/mmdb/cdd'
    shell:
        """
        mkdir -p {params.rpsbproc_dir:q} && \
        cd {params.rpsbproc_dir:q} && \
        echo "Downloading rpsbproc annotation data files..." && \
        wget -q --show-progress -O cddid.tbl.gz {params.base_url}/cddid.tbl.gz && \
        wget -q --show-progress -O cdtrack.txt {params.base_url}/cdtrack.txt && \
        wget -q --show-progress -O family_superfamily_links {params.base_url}/family_superfamily_links && \
        wget -q --show-progress -O cddannot.dat.gz {params.base_url}/cddannot.dat.gz && \
        wget -q --show-progress -O cddannot_generic.dat.gz {params.base_url}/cddannot_generic.dat.gz && \
        wget -q --show-progress -O bitscore_specific.txt {params.base_url}/bitscore_specific.txt && \
        echo "Decompressing files..." && \
        gunzip -f cddid.tbl.gz && \
        gunzip -f cddannot.dat.gz && \
        gunzip -f cddannot_generic.dat.gz && \
        echo "rpsbproc data download complete."
        """

rule setup_databases:
    """Master rule to download all required databases."""
    input:
        cdd_pal=rules.cdd_database_downloader.output.pal,
        rpsbproc_data=rules.rpsbproc_data_downloader.output,
    shell:
        """
        echo "All databases have been downloaded and configured."
        """

rule blast_db_generator_setup:
    input:
        fa = str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}.fa')
    output:
        ndb_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.ndb'),
        nhr_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.nhr'),
        nin_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.nin'),
        not_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.not'),
        nsq_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.nsq'),
        ntf_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.ntf'),
        nto_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.nto'),
    params:
        db_dir=str(defaults.PATH_DICT['SPECIES_DB'])
    shell:
        """
        makeblastdb -in {input.fa:q} -dbtype nucl \
        -out {params.db_dir:q}/{wildcards.genome:q}/{wildcards.genome:q}
        """

rule blast_db_generator:
    input:
        blast_db = expand(str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.{ext}'),
                          genome=defaults.SPECIES,
                          ext=BLAST_DB_EXT)

rule blaster:
    input:
        blast_db=rules.blast_db_generator.input,
        query=rules.query_downloader.input
    output:
        asn_files=expand(str(defaults.PATH_DICT['ASN_TBLASTN_DIR'] / '{genome}.asn'), genome=defaults.SPECIES),
        csv_files=str(defaults.PATH_DICT['TABLE_OUTPUT_DIR'] / 'blast.csv'),
        parquet_files=str(defaults.PATH_DICT['TABLE_OUTPUT_DIR'] / 'blast.parquet')
    shell:
        '''
        python scripts/blast.py
        '''

# =============================================================================
# ORF Analysis (Optional)
# =============================================================================
# When run, this rule ENRICHES blast.parquet with ORF information.
# It adds columns: ORF_Filtered (bool), ORF_COUNT (int), ORF_SUMMARY (string)
# Downstream rules (blast_parser, rpsblaster) auto-detect ORF mode.
# =============================================================================

rule orf_analyser:
    input:
        blast_parquet=rules.blaster.output.parquet_files
    output:
        flag_file=str(defaults.PATH_DICT['ORF_OUTPUT_DIR'] / 'orf_analysis.flag'),
        manifest_file=str(defaults.PATH_DICT['ORF_OUTPUT_DIR'] / 'species_manifest.txt'),
    params:
        species_db=str(defaults.PATH_DICT['SPECIES_DB']),
        output_folder=str(defaults.PATH_DICT['ORF_OUTPUT_DIR']),
        min_orf_length=defaults.MIN_ORF_LENGTH
    shell:
        '''
        Rscript scripts/orf_analyser.R \
        {input.blast_parquet:q} \
        {params.species_db:q} \
        {params.output_folder:q} \
        {params.min_orf_length}
        '''

rule blast_parser:
    input:
        blast_output=rules.blaster.output.parquet_files
    output:
        fasta_files=expand(str(defaults.PATH_DICT['FASTA_OUTPUT_DIR'] / '{genome}.fa'), genome=SPECIES_POST),
    params:
        parquet_file='blast.parquet'
    shell:
        '''
        python scripts/blast_parser.py \
        --input-parquet-file {params.parquet_file:q} \
        --export-fasta
        '''

rule rpsblaster:
    input:
        blast_output=rules.blaster.output,
        cdd_pal=rules.cdd_database_downloader.output.pal,
    output:
        asn_files=expand(str(defaults.PATH_DICT['ASN_RPSBLAST_DIR'] / '{genome}.asn'), genome=SPECIES_POST),
        csv_files=str(defaults.PATH_DICT['TABLE_OUTPUT_DIR'] / 'rpsblast.csv'),
        parquet_files=str(defaults.PATH_DICT['TABLE_OUTPUT_DIR'] / 'rpsblast.parquet')
    shell:
        '''
        python scripts/rpsblast.py
        '''

rule rpsbproc:
    input:
        rpsblast_output=rules.rpsblaster.output,
        rpsbproc_data=rules.rpsbproc_data_downloader.output,
    output:
        rpsbproc_txt=expand(str(defaults.PATH_DICT['RPSBPROC_OUTPUT_DIR'] / '{genome}.txt'), genome=SPECIES_POST),
    shell:
        '''
        python scripts/rpsbproc.py
        '''

rule rpsbproc_parser:
