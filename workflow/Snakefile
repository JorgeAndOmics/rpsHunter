from pathlib import Path
from scripts import defaults

# =============================================================================
# Top-level constants
# =============================================================================

BLAST_DB_EXT = ['ndb', 'nhr', 'nin', 'not', 'nsq', 'ntf', 'nto']
SPECIES = defaults.SPECIES
QUERY_LABELS = defaults.QUERY_LABEL_LIST

# Results base (string for pattern construction)
_R = str(defaults.PATH_DICT['RESULTS_DIR'])

# =============================================================================
# Per-query path patterns (with {query_label} and {species} wildcards)
# =============================================================================

BLAST_PQ     = _R + '/blast/{query_label}/{species}.parquet'
BLAST_CSV    = _R + '/blast/{query_label}/{species}.csv'
ASN_TBLASTN  = _R + '/asn/tblastn/{query_label}/{species}.asn'
ORF_PQ       = _R + '/orf/{query_label}/{species}.parquet'
HMM_PQ       = _R + '/hmmer/{query_label}/{species}.parquet'
FASTA_OUT    = _R + '/fastas/{query_label}/{species}.fa'
FASTA_AUDIT  = _R + '/fastas/{query_label}/{species}.parquet'
SELECTED_PQ  = _R + '/tables/{query_label}/selected/{species}.parquet'
RPSBLAST_PQ  = _R + '/rpsblast/{query_label}/{species}.parquet'
ASN_RPSBLAST = _R + '/asn/rpsblast/{query_label}/{species}.asn'
RPSBPROC_TXT = _R + '/rpsbproc/{query_label}/{species}.txt'
DOMAINS_PQ   = _R + '/domains/{query_label}/{species}.parquet'

# Per-query aggregate tables
AGG_BLAST_PQ  = _R + '/tables/{query_label}/aggregate.parquet'
AGG_BLAST_CSV = _R + '/tables/{query_label}/aggregate.csv'
AGG_RPS_PQ    = _R + '/tables/{query_label}/rpsblast.parquet'
AGG_RPS_CSV   = _R + '/tables/{query_label}/rpsblast.csv'
AGG_DOM_PQ    = _R + '/tables/{query_label}/domains.parquet'
AGG_DOM_CSV   = _R + '/tables/{query_label}/domains.csv'

# Per-query visualization outputs
PQ_TILE      = _R + '/plots/{query_label}/tile_plot.png'
PQ_3D        = _R + '/plots/{query_label}/scatter_3D_plot.html'
PQ_CONT_CSV  = _R + '/tables/{query_label}/contingency_table.csv'
PQ_CONT_PQ   = _R + '/tables/{query_label}/contingency_table.parquet'

# Per-query hit–domain inventory outputs
PQ_HDI_PQ        = _R + '/tables/{query_label}/hit_domain_inventory.parquet'
PQ_HDI_CSV       = _R + '/tables/{query_label}/hit_domain_inventory.csv'
PQ_LDI_PQ        = _R + '/tables/{query_label}/locus_domain_inventory.parquet'
PQ_LDI_CSV       = _R + '/tables/{query_label}/locus_domain_inventory.csv'

# Merged hit–domain inventory outputs
MERGED_HDI_PQ    = _R + '/tables/hit_domain_inventory.parquet'
MERGED_HDI_CSV   = _R + '/tables/hit_domain_inventory.csv'
MERGED_LDI_PQ    = _R + '/tables/locus_domain_inventory.parquet'
MERGED_LDI_CSV   = _R + '/tables/locus_domain_inventory.csv'

# Per-query concordance outputs
PQ_CONC_DIR      = _R + '/tables/{query_label}'
PQ_CONC_DOM      = _R + '/tables/{query_label}/concordance_domains.parquet'
PQ_CONC_DOM_CSV  = _R + '/tables/{query_label}/concordance_domains.csv'
PQ_CONC_SEQ      = _R + '/tables/{query_label}/concordance_sequences.parquet'
PQ_CONC_SEQ_CSV  = _R + '/tables/{query_label}/concordance_sequences.csv'
PQ_CONC_SUM      = _R + '/tables/{query_label}/concordance_summary.parquet'
PQ_CONC_SUM_CSV  = _R + '/tables/{query_label}/concordance_summary.csv'

# Merged concordance outputs
MERGED_CONC_DOM     = _R + '/tables/merged_concordance_domains.parquet'
MERGED_CONC_DOM_CSV = _R + '/tables/merged_concordance_domains.csv'
MERGED_CONC_SEQ     = _R + '/tables/merged_concordance_sequences.parquet'
MERGED_CONC_SEQ_CSV = _R + '/tables/merged_concordance_sequences.csv'
MERGED_CONC_SUM     = _R + '/tables/merged_concordance_summary.parquet'
MERGED_CONC_SUM_CSV = _R + '/tables/merged_concordance_summary.csv'

# Merged outputs (top-level, post-deduplication)
MERGED_DOM_PQ    = _R + '/tables/domains.parquet'
MERGED_DOM_CSV   = _R + '/tables/domains.csv'
MERGED_BLAST_PQ  = _R + '/tables/aggregate.parquet'
MERGED_BLAST_CSV = _R + '/tables/aggregate.csv'
MERGED_RPS_PQ    = _R + '/tables/rpsblast.parquet'
MERGED_RPS_CSV   = _R + '/tables/rpsblast.csv'
MERGED_TILE      = _R + '/plots/tile_plot.png'
MERGED_3D        = _R + '/plots/scatter_3D_plot.html'
MERGED_CONT_CSV  = _R + '/tables/contingency_table.csv'
MERGED_CONT_PQ   = _R + '/tables/contingency_table.parquet'

# Extended visualization suite outputs — paths owned by defaults.py
EXT_CONC_HEATMAP = str(defaults.EXT_CONC_HEATMAP_PATH)
EXT_EVID_QUALITY = str(defaults.EXT_EVID_QUALITY_PATH)
EXT_COMP_BARS    = str(defaults.EXT_COMP_BARS_PATH)
EXT_SEQ_COMPLEX  = str(defaults.EXT_SEQ_COMPLEX_PATH)
EXT_CHR_DENSITY  = str(defaults.EXT_CHR_DENSITY_PATH)
EXT_CROSS_QUERY  = str(defaults.EXT_CROSS_QUERY_PATH)
EXT_HIT_TYPE     = str(defaults.EXT_HIT_TYPE_PATH)

# Enriched blast pattern — determines which per-query per-species directory
# holds the "final" blast parquet after all enabled enrichment steps.
ENRICHED_PATTERN = (
    HMM_PQ if defaults.HMMER_ENABLED
    else ORF_PQ if defaults.ORF_ENABLED
    else BLAST_PQ
)

# Input pattern for HMMER (one step back from ENRICHED_PATTERN).
PRE_HMMER_PATTERN = (
    ORF_PQ if defaults.ORF_ENABLED
    else BLAST_PQ
)

# RPSBLAST database path
RPSBLAST_DB = (
    defaults.PATH_DICT['CDD_SUBSET_DB'] / 'target_domains_db'
    if defaults.RPSBLAST_TARGET_DOMAINS
    else defaults.PATH_DICT['RPS_DB']
)

# Pre-built HMMER subset HMM path
HMMER_SUBSET_HMM = (
    defaults.PATH_DICT['HMM_OUTPUT_DIR'] / 'subset.hmm'
    if defaults.HMMER_PROFILES
    else None
)

configfile: str(defaults.CONFIG_FILE)

# =============================================================================
# Helper functions
# =============================================================================

def query_fasta_for_label(wildcards):
    """Resolve the query FASTA path from a {query_label} wildcard."""
    acc = defaults.LABEL_TO_ACC[wildcards.query_label]
    return str(defaults.query_file_path(acc))

def query_acc_for_label(wildcards):
    """Resolve the query accession from a {query_label} wildcard."""
    return defaults.LABEL_TO_ACC[wildcards.query_label]

# =============================================================================
# Genome & Query Download Rules
# =============================================================================

rule genome_downloader_setup:
    output:
        species=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}.fa')
    params:
        SPECIES_DB=str(defaults.PATH_DICT['SPECIES_DB']),
        DOWNLOAD_LOG=str(defaults.PATH_DICT['CONFIG_DIR'] / 'download.txt'),
        API_KEY=defaults.NCBI_API_TOKEN
    threads:
        workflow.cores / 3
    shell:
        '''
        export NCBI_API_KEY={params.API_KEY:q} && \
        bash scripts/genome_downloader.sh {wildcards.genome:q} {params.SPECIES_DB:q} {params.DOWNLOAD_LOG:q}
        '''

rule genome_downloader:
    input:
        species=expand(str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}.fa'), genome=SPECIES)
    priority: 100
    shell:
        'echo "Genome download completed for selected species"'

rule query_downloader_setup:
    output:
        fasta=str(defaults.PATH_DICT['FASTA_DIR'] / '{query_acc}.fa')
    params:
        query_dir=str(defaults.PATH_DICT['FASTA_DIR']),
        download_log=str(defaults.PATH_DICT['CONFIG_DIR'] / 'download.txt'),
        entrez_email=defaults.ENTREZ_EMAIL
    resources:
        ncbi_api=1   # serialise all query downloads — prevents HTTP 429 from simultaneous efetch calls
    shell:
        '''
        export ENTREZ_EMAIL={params.entrez_email:q} && \
        bash scripts/query_downloader.sh {wildcards.query_acc:q} {params.query_dir:q} {params.download_log:q}
        '''

rule query_downloader:
    input:
        expand(str(defaults.PATH_DICT['FASTA_DIR'] / '{query_acc}.fa'),
               query_acc=defaults.QUERIES)
    priority: 100
    shell:
        'echo "Query protein download completed"'

# =============================================================================
# Database Download Rules
# =============================================================================

rule pfam_hmm_downloader:
    output:
        md5=str(defaults.PATH_DICT['HMM_DB'] / 'md5sum.txt'),
        hmm=str(defaults.PATH_DICT['HMM_DB'] / 'Pfam-A.hmm')
    params:
        hmm_profile_dir=str(defaults.PATH_DICT['HMM_DB']),
        url='https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.gz',
        md5_url='https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/md5_checksums'
    threads:
        workflow.cores
    shell:
        """
        cd {params.hmm_profile_dir:q} && \
        wget -O {output.hmm:q}.gz {params.url:q} && \
        wget -O {output.md5:q} {params.md5_url:q} && \
        grep "Pfam-A.hmm.gz" {output.md5:q} | md5sum -c - && \
        echo "MD5 checksum for HMM profile is correct. Decompressing..." && \
        gunzip -d -f -v -k {params.hmm_profile_dir:q}/Pfam-A.hmm.gz
        """

rule cdd_database_downloader:
    """Download and extract CDD database for RPSBLAST."""
    output:
        pal=str(defaults.PATH_DICT['RPS_DB']) + '.pal',
    params:
        cdd_dir=str(defaults.PATH_DICT['RPS_DB'].parent),
        url='https://ftp.ncbi.nih.gov/pub/mmdb/cdd/little_endian/Cdd_LE.tar.gz'
    threads:
        workflow.cores
    shell:
        """
        mkdir -p {params.cdd_dir:q} && \
        cd {params.cdd_dir:q} && \
        echo "Downloading CDD database (~1.5 GB)..." && \
        wget -q --show-progress -O Cdd_LE.tar.gz {params.url:q} && \
        echo "Extracting CDD database..." && \
        tar -xzf Cdd_LE.tar.gz && \
        rm -f Cdd_LE.tar.gz && \
        echo "CDD database download complete."
        """

rule rpsbproc_data_downloader:
    """Download rpsbproc annotation data files."""
    output:
        cddid=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'cddid.tbl'),
        cdtrack=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'cdtrack.txt'),
        family_links=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'family_superfamily_links'),
        cddannot=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'cddannot.dat'),
        cddannot_generic=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'cddannot_generic.dat'),
        bitscore=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'bitscore_specific.txt'),
    params:
        rpsbproc_dir=str(defaults.PATH_DICT['RPSBPROC_DB']),
        base_url='https://ftp.ncbi.nih.gov/pub/mmdb/cdd'
    shell:
        """
        mkdir -p {params.rpsbproc_dir:q} && \
        cd {params.rpsbproc_dir:q} && \
        echo "Downloading rpsbproc annotation data files..." && \
        wget -q --show-progress -O cddid.tbl.gz {params.base_url}/cddid.tbl.gz && \
        wget -q --show-progress -O cdtrack.txt {params.base_url}/cdtrack.txt && \
        wget -q --show-progress -O family_superfamily_links {params.base_url}/family_superfamily_links && \
        wget -q --show-progress -O cddannot.dat.gz {params.base_url}/cddannot.dat.gz && \
        wget -q --show-progress -O cddannot_generic.dat.gz {params.base_url}/cddannot_generic.dat.gz && \
        wget -q --show-progress -O bitscore_specific.txt {params.base_url}/bitscore_specific.txt && \
        echo "Decompressing files..." && \
        gunzip -f cddid.tbl.gz && \
        gunzip -f cddannot.dat.gz && \
        gunzip -f cddannot_generic.dat.gz && \
        echo "rpsbproc data download complete."
        """

rule cdd_smp_downloader:
    """Download and extract individual CDD SMP files for subset database building."""
    output:
        done=str(defaults.PATH_DICT['SMP_DIR'] / '.download_done')
    params:
        smp_dir=str(defaults.PATH_DICT['SMP_DIR']),
        url='https://ftp.ncbi.nih.gov/pub/mmdb/cdd/cdd.tar.gz'
    threads:
        workflow.cores
    shell:
        """
        mkdir -p {params.smp_dir:q} && \
        cd {params.smp_dir:q} && \
        echo "Downloading CDD SMP archive (~2.2 GB)..." && \
        wget -q --show-progress -O cdd.tar.gz {params.url:q} && \
        echo "Extracting SMP files..." && \
        tar -xzf cdd.tar.gz && \
        rm -f cdd.tar.gz && \
        touch {output.done:q} && \
        echo "CDD SMP extraction complete."
        """

rule setup_databases:
    """Master rule to download all required databases."""
    input:
        cdd_pal=rules.cdd_database_downloader.output.pal,
        rpsbproc_data=rules.rpsbproc_data_downloader.output,
        cdd_smp=rules.cdd_smp_downloader.output.done,
    shell:
        'echo "All databases have been downloaded and configured."'

# =============================================================================
# CDD Subset Database (conditional: rpsblast.target_domains set)
# =============================================================================

if defaults.RPSBLAST_TARGET_DOMAINS:
    rule cdd_subset_builder:
        """Build a subset RPSBLAST database from target domain SMP files."""
        input:
            smp_done=rules.cdd_smp_downloader.output.done,
            cddid=str(defaults.PATH_DICT['RPSBPROC_DB'] / 'cddid.tbl')
        output:
            db=str(RPSBLAST_DB) + '.rps'
        params:
            smp_dir=str(defaults.PATH_DICT['SMP_DIR']),
            db_path=str(RPSBLAST_DB)
        shell:
            '''
            python scripts/cdd_subset.py \
                --cddid {input.cddid:q} \
                --smp-dir {params.smp_dir:q} \
                --output-db {params.db_path:q}
            '''

# =============================================================================
# HMMER Profile Extraction (conditional: hmmer.profiles set)
# =============================================================================

if defaults.HMMER_ENABLED and defaults.HMMER_PROFILES:
    rule hmmer_extract_profiles:
        """Extract and press HMMER subset profiles once for all species."""
        input:
            pfam_hmm=str(defaults.PATH_DICT['HMM_DB'] / 'Pfam-A.hmm')
        output:
            subset_hmm=str(HMMER_SUBSET_HMM)
        shell:
            '''
            python scripts/hmmer.py \
                --extract-only \
                {input.pfam_hmm:q} \
                {output.subset_hmm:q}
            '''

# =============================================================================
# BLAST DB Generation
# =============================================================================

rule blast_db_generator_setup:
    input:
        fa = str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}.fa')
    output:
        ndb_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.ndb'),
        nhr_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.nhr'),
        nin_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.nin'),
        not_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.not'),
        nsq_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.nsq'),
        ntf_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.ntf'),
        nto_file=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.nto'),
    params:
        db_dir=str(defaults.PATH_DICT['SPECIES_DB']),
        makeblastdb_cmd=defaults.MAKEBLASTDB_CMD
    shell:
        """
        {params.makeblastdb_cmd} -in {input.fa:q} -dbtype nucl \
        -out {params.db_dir:q}/{wildcards.genome:q}/{wildcards.genome:q}
        """

rule blast_db_generator:
    input:
        blast_db = expand(str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}' / '{genome}.{ext}'),
                          genome=SPECIES,
                          ext=BLAST_DB_EXT)

# =============================================================================
# Per-Query Per-Species BLAST
# =============================================================================

rule blast_species:
    input:
        db=str(defaults.PATH_DICT['SPECIES_DB'] / '{species}' / '{species}.ndb'),
        query=query_fasta_for_label
    output:
        parquet=BLAST_PQ,
        csv=BLAST_CSV,
        asn=ASN_TBLASTN
    params:
        query_acc=query_acc_for_label
    threads: 1
    shell:
        '''
        python scripts/blast.py \
            --species {wildcards.species} \
            --query-file {input.query:q} \
            --query-accession {params.query_acc} \
            --output-parquet {output.parquet:q} \
            --output-csv {output.csv:q} \
            --output-asn {output.asn:q}
        '''

# =============================================================================
# Per-Query Per-Species ORF Analysis (conditional)
# =============================================================================

if defaults.ORF_ENABLED:
    rule orf_species:
        input:
            parquet=BLAST_PQ,
            genome=str(defaults.PATH_DICT['SPECIES_DB'] / '{species}.fa')
        output:
            parquet=ORF_PQ
        threads: 1
        shell:
            '''
            Rscript scripts/orf_analyser.R \
                --species {wildcards.species} \
                {input.parquet:q} \
                {input.genome:q} \
                {output.parquet:q}
            '''

# =============================================================================
# Per-Query Per-Species HMMER (conditional)
# =============================================================================

if defaults.HMMER_ENABLED:
    rule hmmer_species:
        input:
            parquet=PRE_HMMER_PATTERN,
            pfam_hmm=str(defaults.PATH_DICT['HMM_DB'] / 'Pfam-A.hmm'),
            subset_hmm=(str(HMMER_SUBSET_HMM)
                        if defaults.HMMER_PROFILES
                        else [])
        output:
            parquet=HMM_PQ
        params:
            hmm_db_flag=('--hmm-db ' + str(HMMER_SUBSET_HMM)
                         if defaults.HMMER_PROFILES
                         else '')
        threads:
            workflow.cores
        shell:
            '''
            python scripts/hmmer.py \
                --species {wildcards.species} \
                --threads {threads} \
                {params.hmm_db_flag} \
                {input.parquet:q} \
                {input.pfam_hmm:q} \
                {output.parquet:q}
            '''

# =============================================================================
# Per-Query Per-Species BLAST Parser
# =============================================================================

rule blast_parser_species:
    input:
        parquet=ENRICHED_PATTERN
    output:
        fasta=FASTA_OUT,
        audit=FASTA_AUDIT,
        selected=SELECTED_PQ
    params:
        query_acc=query_acc_for_label
    threads: 1
    shell:
        '''
        python scripts/blast_parser.py \
            --species {wildcards.species} \
            --query-accession {params.query_acc} \
            --input-parquet {input.parquet:q} \
            --output-fasta {output.fasta:q} \
            --output-audit {output.audit:q} \
            --output-selected {output.selected:q}
        '''

# =============================================================================
# Per-Query Per-Species RPSBLAST
# =============================================================================

rule rpsblast_species:
    input:
        fasta=FASTA_OUT,
        cdd_db=(str(RPSBLAST_DB) + '.rps'
                if defaults.RPSBLAST_TARGET_DOMAINS
                else str(defaults.PATH_DICT['RPS_DB']) + '.pal')
    output:
        parquet=RPSBLAST_PQ,
        asn=ASN_RPSBLAST
    params:
        db_flag=('--db ' + str(RPSBLAST_DB)
                 if defaults.RPSBLAST_TARGET_DOMAINS
                 else ''),
        query_acc=query_acc_for_label
    threads: 1
    shell:
        '''
        python scripts/rpsblast.py \
            --species {wildcards.species} \
            --query-accession {params.query_acc} \
            --fasta-input {input.fasta:q} \
            --output-parquet {output.parquet:q} \
            --output-asn {output.asn:q} \
            {params.db_flag}
        '''

# =============================================================================
# Per-Query Per-Species rpsbproc
# =============================================================================

rule rpsbproc_species:
    input:
        asn=ASN_RPSBLAST,
        rpsbproc_data=rules.rpsbproc_data_downloader.output
    output:
        txt=RPSBPROC_TXT
    threads: 1
    shell:
        '''
        python scripts/rpsbproc.py \
            --input-asn {input.asn:q} \
            --output-txt {output.txt:q}
        '''

# =============================================================================
# Per-Query Per-Species rpsbproc Parser
# =============================================================================

rule rpsbproc_parser_species:
    input:
        txt=RPSBPROC_TXT
    output:
        parquet=DOMAINS_PQ
    params:
        query_acc=query_acc_for_label
    threads: 1
    shell:
        '''
        python scripts/rpsbproc_parser.py \
            --input-txt {input.txt:q} \
            --output-parquet {output.parquet:q} \
            --query-accession {params.query_acc}
        '''

# =============================================================================
# Per-Query Aggregation Rules
# =============================================================================

rule aggregate_blast:
    """Per-query: aggregates the FINAL enriched blast parquets across species."""
    input:
        lambda wc: expand(ENRICHED_PATTERN, query_label=wc.query_label, species=SPECIES)
    output:
        parquet=AGG_BLAST_PQ,
        csv=AGG_BLAST_CSV
    shell:
        'python scripts/aggregate.py blast {output.parquet:q} {input}'

rule aggregate_rpsblast:
    input:
        lambda wc: expand(RPSBLAST_PQ, query_label=wc.query_label, species=SPECIES)
    output:
        parquet=AGG_RPS_PQ,
        csv=AGG_RPS_CSV
    shell:
        'python scripts/aggregate.py rpsblast {output.parquet:q} {input}'

rule aggregate_domains:
    input:
        lambda wc: expand(DOMAINS_PQ, query_label=wc.query_label, species=SPECIES)
    output:
        parquet=AGG_DOM_PQ,
        csv=AGG_DOM_CSV
    shell:
        'python scripts/aggregate.py domains {output.parquet:q} {input}'

# =============================================================================
# Cross-Query Merge Rules
# =============================================================================

rule merge_blast:
    """Concatenate per-query blast aggregates into a single merged table."""
    input:
        expand(AGG_BLAST_PQ, query_label=QUERY_LABELS)
    output:
        parquet=MERGED_BLAST_PQ,
        csv=MERGED_BLAST_CSV
    shell:
        'python scripts/aggregate.py blast {output.parquet:q} {input}'

rule merge_rpsblast:
    """Concatenate per-query rpsblast aggregates."""
    input:
        expand(AGG_RPS_PQ, query_label=QUERY_LABELS)
    output:
        parquet=MERGED_RPS_PQ,
        csv=MERGED_RPS_CSV
    shell:
        'python scripts/aggregate.py rpsblast {output.parquet:q} {input}'

rule merge_domains:
    """Merge per-query domain tables with cross-query deduplication."""
    input:
        expand(AGG_DOM_PQ, query_label=QUERY_LABELS)
    output:
        parquet=MERGED_DOM_PQ,
        csv=MERGED_DOM_CSV
    params:
        config_path=str(defaults.CONFIG_FILE)
    shell:
        '''
        Rscript scripts/merge_queries.R \
            {output.parquet:q} \
            {params.config_path:q} \
            {input}
        '''

# =============================================================================
# Per-Query Visualization Rules
# =============================================================================

rule pq_completeness_detector:
    input:
        domains=AGG_DOM_PQ,
        blast=AGG_BLAST_PQ,
        rpsblast=AGG_RPS_PQ
    output:
        tile_plot=PQ_TILE
    params:
        config_path=str(defaults.CONFIG_FILE)
    shell:
        '''
        Rscript scripts/completeness_detector.R \
            {input.domains:q} \
            $(dirname {output.tile_plot:q}) \
            {params.config_path:q}
        '''

rule pq_contingency_sorter:
    input:
        domains=AGG_DOM_PQ,
        blast=AGG_BLAST_PQ,
        rpsblast=AGG_RPS_PQ
    output:
        domain_3d_plot=PQ_3D,
        contingency_table=PQ_CONT_CSV,
        contingency_parquet=PQ_CONT_PQ
    params:
        range_dir=lambda wc: _R + '/ranges/' + wc.query_label,
        config_path=str(defaults.CONFIG_FILE)
    shell:
        '''
        Rscript scripts/contingency_sorter.R \
            {input.domains:q} \
            $(dirname {output.domain_3d_plot:q}) \
            $(dirname {output.contingency_table:q}) \
            {params.range_dir:q} \
            {params.config_path:q}
        '''

rule pq_concordance:
    """Per-query concordance analysis (HMMER vs CDD agreement)."""
    input:
        aggregate=AGG_BLAST_PQ,
        domains=AGG_DOM_PQ
    output:
        conc_dom=PQ_CONC_DOM,
        conc_dom_csv=PQ_CONC_DOM_CSV,
        conc_seq=PQ_CONC_SEQ,
        conc_seq_csv=PQ_CONC_SEQ_CSV,
        conc_sum=PQ_CONC_SUM,
        conc_sum_csv=PQ_CONC_SUM_CSV
    params:
        config_path=str(defaults.CONFIG_FILE),
        outdir=PQ_CONC_DIR
    shell:
        '''
        python scripts/concordance.py \
            --aggregate {input.aggregate:q} \
            --domains {input.domains:q} \
            --config {params.config_path:q} \
            --outdir {params.outdir:q}
        '''

