# Per-Query Per-Species rpsbproc Parser
# =============================================================================

rule call_domains_species:
    """Domain calls of one query and species: family, evidence tier, own coordinates."""
    input:
        report=RPSBPROC_TXT,
        alignments=RPSBLAST_PQ
    output:
        parquet=DOMAINS_PQ
    params:
        settings=tracked('domains', 'rpsblast.e_value'),
        query_acc=query_acc_for_label
    threads: 1
    log:
        job_log('call_domains_species', 'query_label', 'species')
    benchmark:
        job_benchmark('call_domains_species', 'query_label', 'species')
    shell:
        '''
        (
        python scripts/call_domains.py \
            --species {wildcards.species} \
            --query-accession {params.query_acc} \
            --report {input.report:q} \
            --alignments {input.alignments:q} \
            --output {output.parquet:q}
        ) > {log:q} 2>&1
        '''

# =============================================================================
# Per-Query Aggregation Rules
# =============================================================================

rule aggregate_blast:
    """Per-query: aggregates the FINAL enriched blast parquets across species."""
    input:
        lambda wc: expand(ENRICHED_PATTERN, query_label=wc.query_label, species=SPECIES)
    output:
        parquet=AGG_BLAST_PQ,
        csv=AGG_BLAST_CSV
    log:
        job_log('aggregate_blast', 'query_label')
    benchmark:
        job_benchmark('aggregate_blast', 'query_label')
    shell:
        'python scripts/aggregate.py blast {output.parquet:q} {input} > {log:q} 2>&1'

rule aggregate_rpsblast:
    input:
        lambda wc: expand(RPSBLAST_PQ, query_label=wc.query_label, species=SPECIES)
    output:
        parquet=AGG_RPS_PQ,
        csv=AGG_RPS_CSV
    log:
        job_log('aggregate_rpsblast', 'query_label')
    benchmark:
        job_benchmark('aggregate_rpsblast', 'query_label')
    shell:
        'python scripts/aggregate.py rpsblast {output.parquet:q} {input} > {log:q} 2>&1'

# =============================================================================
# Cross-Query Merge Rules
# =============================================================================

rule merge_blast:
    """Concatenate per-query blast aggregates into a single merged table."""
    input:
        expand(AGG_BLAST_PQ, query_label=QUERY_LABELS)
    output:
        parquet=MERGED_BLAST_PQ,
        csv=MERGED_BLAST_CSV
    log:
        job_log('merge_blast')
    benchmark:
        job_benchmark('merge_blast')
    shell:
        'python scripts/aggregate.py blast {output.parquet:q} {input} > {log:q} 2>&1'

rule merge_rpsblast:
    """Concatenate per-query rpsblast aggregates."""
    input:
        expand(AGG_RPS_PQ, query_label=QUERY_LABELS)
    output:
        parquet=MERGED_RPS_PQ,
        csv=MERGED_RPS_CSV
    log:
        job_log('merge_rpsblast')
    benchmark:
        job_benchmark('merge_rpsblast')
    shell:
        'python scripts/aggregate.py rpsblast {output.parquet:q} {input} > {log:q} 2>&1'

rule domain_tables:
    """All domain calls, the domain instances they merge into, and a GFF3 per species."""
    input:
        expand(DOMAINS_PQ, query_label=QUERY_LABELS, species=SPECIES)
    output:
        calls=CALLS_PQ,
        calls_csv=CALLS_CSV,
        domains=MERGED_DOM_PQ,
        domains_csv=MERGED_DOM_CSV,
        gff=expand(GFF3, species=SPECIES)
    params:
        gff_dir=str(defaults.PATH_DICT['RANGE_OUTPUT_DIR'])
    log:
        job_log('domain_tables')
    benchmark:
        job_benchmark('domain_tables')
    shell:
        '''
        (
        python scripts/domain_tables.py \
            --calls-out {output.calls:q} \
            --domains-out {output.domains:q} \
            --gff-dir {params.gff_dir:q} \
            {input:q}
        ) > {log:q} 2>&1
        '''

# =============================================================================
# Loci
# =============================================================================

rule locus_tables:
    """Gated hits chained into loci, with the families each locus carries."""
    input:
        hits=expand(SELECTED_PQ, query_label=QUERY_LABELS, species=SPECIES),
        calls=expand(DOMAINS_PQ, query_label=QUERY_LABELS, species=SPECIES)
    output:
        loci=LOCI_PQ,
        loci_csv=LOCI_CSV,
        families=LOCUS_FAM_PQ,
        families_csv=LOCUS_FAM_CSV
    params:
        settings=tracked('loci', 'domains')
    log:
        job_log('locus_tables')
    benchmark:
        job_benchmark('locus_tables')
    shell:
        '''
        (
        python scripts/locus_tables.py \
            --loci-out {output.loci:q} \
            --families-out {output.families:q} \
            --hits {input.hits:q} \
            --calls {input.calls:q}
        ) > {log:q} 2>&1
        '''

# =============================================================================
# Target Rules (CLI entry points — one per pipeline stage)
# Each triggers only its own per-species jobs.  Snakemake resolves upstream
# dependencies automatically.
# =============================================================================

rule blaster:
    """Per-query per-species BLAST."""
    input:
        expand(BLAST_PQ, query_label=QUERY_LABELS, species=SPECIES)

rule orf_analyser:
    """Per-query ORF analysis (no-op if orf.enabled: false)."""
    input:
        expand(ORF_PQ, query_label=QUERY_LABELS, species=SPECIES) if defaults.ORF_ENABLED else []

rule hmmer:
    """Per-query HMMER filtering (no-op if hmmer.enabled: false)."""
    input:
        expand(HMM_PQ, query_label=QUERY_LABELS, species=SPECIES) if defaults.HMMER_ENABLED else []

rule blast_parser:
    """Per-query FASTA export, aggregation, and cross-query merge."""
    input:
        expand(FASTA_OUT, query_label=QUERY_LABELS, species=SPECIES),
        expand(AGG_BLAST_PQ, query_label=QUERY_LABELS),
        MERGED_BLAST_PQ

rule rpsblaster:
    """Per-query RPSBLAST."""
    input:
        expand(RPSBLAST_PQ, query_label=QUERY_LABELS, species=SPECIES)

rule rpsbproc:
    """Per-query rpsbproc annotation."""
    input:
        expand(RPSBPROC_TXT, query_label=QUERY_LABELS, species=SPECIES)

rule rpsbproc_parser:
    """Domain calls, domain instances and GFF3 tracks."""
    input:
        CALLS_PQ,
        MERGED_DOM_PQ,
        expand(GFF3, species=SPECIES)

rule loci:
    """Loci and the families each carries."""
    input:
        LOCI_PQ,
        LOCUS_FAM_PQ
