PssmWithParameters ::= {
  pssm {
    isProtein TRUE,
    numRows 28,
    numColumns 31,
    byRow FALSE,
    query seq {
      id {
        general {
          db "CDD",
          tag id 518941
        }
      },
      descr {
        title "pfam09514, SSXRD, SSXRD motif.  SSX1 can repress transcription,
 and this has been attributed to a putative Kruppel associated box (KRAB)
 repression domain at the N-terminus. However, from the analysis of these
 deletion constructs further repression activity was found at the C-terminus
 of SSX1. Which has been called the SSXRD (SSX Repression Domain). The potent
 repression exerted by full-length SSX1 appears to localise to this region.",
        org {
          taxname "Theria",
          db {
            {
              db "taxon",
              tag id 32525
            }
          },
          orgname {
            name partial {
              {
                fixed-level other,
                level "no rank",
                name "Theria"
              }
            },
            lineage "Eukaryota; Metazoa; Chordata; Craniata; Vertebrata;
 Euteleostomi; Mammalia",
            gcode 1,
            mgcode 2,
            div "MAM"
          }
        }
      },
      inst {
        repr raw,
        mol aa,
        length 31,
        seq-data ncbieaa "LRRKEVEVWMYSLRERKGVAYEEISDPQDDD"
      }
    },
