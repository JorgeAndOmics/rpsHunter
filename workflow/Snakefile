import sys
from pathlib import Path

# The scripts import one another as flat modules (they are run as files), so the
# Snakefile imports them the same way; importing through a 'scripts' package
# would leave their sibling imports unresolved.
sys.path.insert(0, str(Path(workflow.basedir) / 'scripts'))
import defaults

# The one place directories are created for a run (see defaults.ensure_dirs).
defaults.ensure_dirs()

# =============================================================================
# Top-level constants
# =============================================================================

BLAST_DB_EXT = ['ndb', 'nhr', 'nin', 'not', 'nsq', 'ntf', 'nto']
SPECIES = defaults.SPECIES
QUERY_LABELS = defaults.QUERY_LABEL_LIST

# Results base (string for pattern construction)
_R = str(defaults.PATH_DICT['RESULTS_DIR'])

# =============================================================================
# Per-query path patterns (with {query_label} and {species} wildcards)
# =============================================================================

BLAST_PQ     = _R + '/blast/{query_label}/{species}.parquet'
BLAST_CSV    = _R + '/blast/{query_label}/{species}.csv'
ASN_TBLASTN  = _R + '/asn/tblastn/{query_label}/{species}.asn'
ORF_PQ       = _R + '/orf/{query_label}/{species}.parquet'
HMM_PQ       = _R + '/hmmer/{query_label}/{species}.parquet'
FASTA_OUT    = _R + '/fastas/{query_label}/{species}.fa'
FASTA_AUDIT  = _R + '/fastas/{query_label}/{species}.parquet'
SELECTED_PQ  = _R + '/tables/blast/{query_label}/selected/{species}.parquet'
RPSBLAST_PQ  = _R + '/rpsblast/{query_label}/{species}.parquet'
ASN_RPSBLAST = _R + '/asn/rpsblast/{query_label}/{species}.asn'
RPSBPROC_TXT = _R + '/rpsbproc/{query_label}/{species}.txt'
DOMAINS_PQ   = _R + '/domains/{query_label}/{species}.parquet'

# Per-query aggregate tables
AGG_BLAST_PQ  = _R + '/tables/blast/{query_label}/aggregate.parquet'
AGG_BLAST_CSV = _R + '/tables/blast/{query_label}/aggregate.csv'
AGG_RPS_PQ    = _R + '/tables/rpsblast/{query_label}/rpsblast.parquet'
AGG_RPS_CSV   = _R + '/tables/rpsblast/{query_label}/rpsblast.csv'

# Merged outputs (top-level, post-deduplication)
MERGED_DOM_PQ    = _R + '/tables/domains/domains.parquet'
MERGED_DOM_CSV   = _R + '/tables/domains/domains.csv'
CALLS_PQ         = _R + '/tables/domains/calls.parquet'
CALLS_CSV        = _R + '/tables/domains/calls.csv'
GFF3             = _R + '/ranges/{species}.gff3'
LOCI_PQ          = _R + '/tables/loci/loci.parquet'
LOCI_CSV         = _R + '/tables/loci/loci.csv'
LOCUS_FAM_PQ     = _R + '/tables/loci/locus_families.parquet'
LOCUS_FAM_CSV    = _R + '/tables/loci/locus_families.csv'
MERGED_BLAST_PQ  = _R + '/tables/blast/aggregate.parquet'
MERGED_BLAST_CSV = _R + '/tables/blast/aggregate.csv'
MERGED_RPS_PQ    = _R + '/tables/rpsblast/rpsblast.parquet'
MERGED_RPS_CSV   = _R + '/tables/rpsblast/rpsblast.csv'

# Enriched blast pattern — determines which per-query per-species directory
# holds the "final" blast parquet after all enabled enrichment steps.
ENRICHED_PATTERN = (
    HMM_PQ if defaults.HMMER_ENABLED
    else ORF_PQ if defaults.ORF_ENABLED
    else BLAST_PQ
)

# Input pattern for HMMER (one step back from ENRICHED_PATTERN).
PRE_HMMER_PATTERN = (
    ORF_PQ if defaults.ORF_ENABLED
    else BLAST_PQ
)

# RPSBLAST database path
RPSBLAST_DB = defaults.PATH_DICT['CDD_SUBSET_DB'] / 'families_db'

# Pre-built HMMER subset HMM path
HMMER_SUBSET_HMM = (
    defaults.PATH_DICT['HMM_OUTPUT_DIR'] / 'subset.hmm'
    if defaults.PFAM_ACCESSIONS
    else None
)

configfile: str(defaults.CONFIG_FILE)

# =============================================================================
# Helper functions
# =============================================================================

def query_fasta_for_label(wildcards):
    """Resolve the query FASTA path from a {query_label} wildcard."""
    acc = defaults.LABEL_TO_ACC[wildcards.query_label]
    return str(defaults.query_file_path(acc))

def query_acc_for_label(wildcards):
    """Resolve the query accession from a {query_label} wildcard."""
    return defaults.LABEL_TO_ACC[wildcards.query_label]

def assembly_for_genome(wildcards):
    """Assembly accession to download for a {genome}, or '' if the config pins that
    species by checksum only. Snakemake evaluates this while planning, also for
    genomes that are already present, so it must not raise: the downloader itself
    refuses an empty accession, which only happens if a download is really needed."""
    return defaults.SPECIES_ENTRIES[wildcards.genome].assembly or ''

def tracked(*keys):
    """Config values a rule depends on, as one stable string for its `params`.

    The scripts read their settings through defaults.py, which Snakemake cannot
    see. Naming them here makes a changed threshold rerun exactly the rules that
    use it. A key is a config section ('hmmer') or one value in it ('blast.e_value').
    """
    import json
    values = {}
    for key in keys:
        value = config
        for part in key.split('.'):
            value = (value or {}).get(part)
        values[key] = value
    return json.dumps(values, sort_keys=True)

def _job_file(kind, rule, wildcard_names, suffix):
    """Path of a per-job file: <logs>/<kind>/<rule>/<wildcard values...>.<suffix>."""
    name = '/'.join('{' + w + '}' for w in wildcard_names) or 'all'
    return str(defaults.PATH_DICT['LOG_DIR'] / kind / rule / f'{name}.{suffix}')

def job_log(rule, *wildcard_names):
    """Log file of one job; every rule that runs a command writes its output here."""
    return _job_file('jobs', rule, wildcard_names, 'log')

def job_benchmark(rule, *wildcard_names):
    """Benchmark file of one job (wall time, memory), written by Snakemake."""
    return _job_file('benchmarks', rule, wildcard_names, 'tsv')

# =============================================================================
# Genome & Query Download Rules
# =============================================================================

rule genome_downloader_setup:
    output:
        species=str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}.fa')
    params:
        SPECIES_DB=str(defaults.PATH_DICT['SPECIES_DB']),
        DOWNLOAD_LOG=str(defaults.PATH_DICT['CONFIG_DIR'] / 'download.txt'),
        assembly=assembly_for_genome
    threads:
        workflow.cores / 3
    log:
        job_log('genome_downloader_setup', 'genome')
    benchmark:
        job_benchmark('genome_downloader_setup', 'genome')
    shell:
        '''
        (
        bash scripts/genome_downloader.sh {wildcards.genome:q} {params.assembly:q} \
            {params.SPECIES_DB:q} {params.DOWNLOAD_LOG:q}
        ) > {log:q} 2>&1
        '''

rule genome_downloader:
    input:
        species=expand(str(defaults.PATH_DICT['SPECIES_DB'] / '{genome}.fa'), genome=SPECIES)
    priority: 100
    shell:
        'echo "Genome download completed for selected species"'

rule query_downloader_setup:
    output:
        fasta=str(defaults.PATH_DICT['FASTA_DIR'] / '{query_acc}.fa')
    params:
        query_dir=str(defaults.PATH_DICT['FASTA_DIR']),
        download_log=str(defaults.PATH_DICT['CONFIG_DIR'] / 'download.txt'),
        entrez_email=defaults.ENTREZ_EMAIL
    resources:
        ncbi_api=1   # serialise all query downloads — prevents HTTP 429 from simultaneous efetch calls
    log:
        job_log('query_downloader_setup', 'query_acc')
    benchmark:
        job_benchmark('query_downloader_setup', 'query_acc')
    shell:
        '''
        (
        export ENTREZ_EMAIL={params.entrez_email:q} && \
        bash scripts/query_downloader.sh {wildcards.query_acc:q} {params.query_dir:q} {params.download_log:q}
        ) > {log:q} 2>&1
        '''

rule query_downloader:
    input:
        expand(str(defaults.PATH_DICT['FASTA_DIR'] / '{query_acc}.fa'),
               query_acc=defaults.QUERIES)
    priority: 100
    shell:
        'echo "Query protein download completed"'

# =============================================================================
# Database Download Rules
