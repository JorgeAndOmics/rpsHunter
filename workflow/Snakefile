rule pq_hit_domain_inventory:
    """Per-query hit–domain inventory (BLAST hits joined with CDD domains)."""
    input:
        aggregate=AGG_BLAST_PQ,
        domains=AGG_DOM_PQ
    output:
        hit_pq=PQ_HDI_PQ,
        hit_csv=PQ_HDI_CSV,
        locus_pq=PQ_LDI_PQ,
        locus_csv=PQ_LDI_CSV
    params:
        config_path=str(defaults.CONFIG_FILE),
        outdir=_R + '/tables/{query_label}'
    shell:
        '''
        python scripts/hit_domain_inventory.py \
            --aggregate {input.aggregate:q} \
            --domains {input.domains:q} \
            --config {params.config_path:q} \
            --outdir {params.outdir:q}
        '''

rule merge_hit_domain_inventory:
    """Cross-query hit–domain and locus–domain inventories."""
    input:
        aggregates=expand(AGG_BLAST_PQ, query_label=QUERY_LABELS),
        domains=expand(AGG_DOM_PQ, query_label=QUERY_LABELS)
    output:
        hit_pq=MERGED_HDI_PQ,
        hit_csv=MERGED_HDI_CSV,
        locus_pq=MERGED_LDI_PQ,
        locus_csv=MERGED_LDI_CSV
    params:
        config_path=str(defaults.CONFIG_FILE),
        outdir=str(defaults.PATH_DICT['TABLE_OUTPUT_DIR'])
    shell:
        '''
        python scripts/hit_domain_inventory.py \
            --aggregate {input.aggregates} \
            --domains {input.domains} \
            --config {params.config_path:q} \
            --outdir {params.outdir:q}
        '''

rule merge_concordance:
    """Merge per-query concordance tables (Parquet + CSV)."""
    input:
        conc_dom=expand(PQ_CONC_DOM, query_label=QUERY_LABELS),
        conc_seq=expand(PQ_CONC_SEQ, query_label=QUERY_LABELS),
        conc_sum=expand(PQ_CONC_SUM, query_label=QUERY_LABELS)
    output:
        conc_dom=MERGED_CONC_DOM,
        conc_dom_csv=MERGED_CONC_DOM_CSV,
        conc_seq=MERGED_CONC_SEQ,
        conc_seq_csv=MERGED_CONC_SEQ_CSV,
        conc_sum=MERGED_CONC_SUM,
        conc_sum_csv=MERGED_CONC_SUM_CSV
    shell:
        '''
        python -c "
import pandas as pd
from pathlib import Path

for inputs, out_pq, out_csv in [
    ('{input.conc_dom}'.split(), '{output.conc_dom}', '{output.conc_dom_csv}'),
    ('{input.conc_seq}'.split(), '{output.conc_seq}', '{output.conc_seq_csv}'),
    ('{input.conc_sum}'.split(), '{output.conc_sum}', '{output.conc_sum_csv}'),
]:
    dfs = [pd.read_parquet(f) for f in inputs if Path(f).exists()]
    merged = pd.concat(dfs, ignore_index=True) if dfs else pd.DataFrame()
    merged.to_parquet(out_pq, index=False)
    merged.to_csv(out_csv, index=False)
    print(f'Merged {{len(dfs)}} files -> {{len(merged)}} rows -> {{out_pq}}')
"
        '''

# =============================================================================
# Target Rules (CLI entry points — one per pipeline stage)
# Each triggers only its own per-species jobs.  Snakemake resolves upstream
# dependencies automatically.
# =============================================================================

rule blaster:
    """Per-query per-species BLAST."""
    input:
        expand(BLAST_PQ, query_label=QUERY_LABELS, species=SPECIES)

rule orf_analyser:
    """Per-query ORF analysis (no-op if orf.enabled: false)."""
    input:
        expand(ORF_PQ, query_label=QUERY_LABELS, species=SPECIES) if defaults.ORF_ENABLED else []

rule hmmer:
    """Per-query HMMER filtering (no-op if hmmer.enabled: false)."""
    input:
        expand(HMM_PQ, query_label=QUERY_LABELS, species=SPECIES) if defaults.HMMER_ENABLED else []

rule blast_parser:
    """Per-query FASTA export, aggregation, and cross-query merge."""
    input:
        expand(FASTA_OUT, query_label=QUERY_LABELS, species=SPECIES),
        expand(AGG_BLAST_PQ, query_label=QUERY_LABELS),
        MERGED_BLAST_PQ

rule rpsblaster:
    """Per-query RPSBLAST."""
    input:
        expand(RPSBLAST_PQ, query_label=QUERY_LABELS, species=SPECIES)

rule rpsbproc:
    """Per-query rpsbproc annotation."""
    input:
        expand(RPSBPROC_TXT, query_label=QUERY_LABELS, species=SPECIES)

rule rpsbproc_parser:
    """Per-query parsing + per-query aggregation + cross-query merge."""
    input:
        expand(AGG_DOM_PQ, query_label=QUERY_LABELS),
        MERGED_DOM_PQ

rule completeness_detector:
    """Per-query + merged tile plots."""
    input:
        expand(PQ_TILE, query_label=QUERY_LABELS),
        MERGED_TILE

rule contingency_sorter:
    """Per-query + merged contingency/scatter plots."""
    input:
        expand(PQ_3D, query_label=QUERY_LABELS),
        expand(PQ_CONT_CSV, query_label=QUERY_LABELS),
        expand(PQ_CONT_PQ, query_label=QUERY_LABELS),
        MERGED_3D,
        MERGED_CONT_CSV,
        MERGED_CONT_PQ

rule hit_domain_inventory:
    """Per-query + merged hit–domain and locus–domain inventories."""
    input:
        expand(PQ_HDI_PQ, query_label=QUERY_LABELS),
        expand(PQ_HDI_CSV, query_label=QUERY_LABELS),
        expand(PQ_LDI_PQ, query_label=QUERY_LABELS),
        expand(PQ_LDI_CSV, query_label=QUERY_LABELS),
        MERGED_HDI_PQ,
        MERGED_HDI_CSV,
        MERGED_LDI_PQ,
        MERGED_LDI_CSV

rule concordance:
    """Per-query + merged concordance analysis."""
    input:
        expand(PQ_CONC_DOM, query_label=QUERY_LABELS),
        expand(PQ_CONC_DOM_CSV, query_label=QUERY_LABELS),
        expand(PQ_CONC_SEQ, query_label=QUERY_LABELS),
        expand(PQ_CONC_SEQ_CSV, query_label=QUERY_LABELS),
        expand(PQ_CONC_SUM, query_label=QUERY_LABELS),
        expand(PQ_CONC_SUM_CSV, query_label=QUERY_LABELS),
        MERGED_CONC_DOM,
        MERGED_CONC_DOM_CSV,
        MERGED_CONC_SEQ,
        MERGED_CONC_SEQ_CSV,
        MERGED_CONC_SUM,
        MERGED_CONC_SUM_CSV

rule extended_plots:
    """Extended visualization suite: 7 analytical plots from merged domain and concordance data."""
    input:
        domains        = MERGED_DOM_PQ,
        conc_domains   = MERGED_CONC_DOM,
        conc_sequences = MERGED_CONC_SEQ,
        contingency    = MERGED_CONT_PQ,
        config_path    = str(defaults.CONFIG_FILE),
    output:
        concordance_heatmap = EXT_CONC_HEATMAP,
        evidence_quality    = EXT_EVID_QUALITY,
        completeness_bars   = EXT_COMP_BARS,
        sequence_complexity = EXT_SEQ_COMPLEX,
        chromosomal_density = EXT_CHR_DENSITY,
        cross_query         = EXT_CROSS_QUERY,
        hit_type            = EXT_HIT_TYPE,
    script:
        'scripts/extended_plots.R'
