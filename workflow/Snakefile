            parquet=ORF_PQ
        threads: 1
        params:
            settings=tracked('orf')
        log:
            job_log('orf_species', 'query_label', 'species')
        benchmark:
            job_benchmark('orf_species', 'query_label', 'species')
        shell:
            '''
            (
            Rscript scripts/orf_analyser.R \
                --species {wildcards.species} \
                {input.parquet:q} \
                {input.genome:q} \
                {output.parquet:q}
            ) > {log:q} 2>&1
            '''

# =============================================================================
# Per-Query Per-Species HMMER (conditional)
# =============================================================================

if defaults.HMMER_ENABLED:
    rule hmmer_species:
        input:
            parquet=PRE_HMMER_PATTERN,
            pfam_hmm=str(defaults.PATH_DICT['HMM_DB'] / 'Pfam-A.hmm'),
            subset_hmm=(str(HMMER_SUBSET_HMM)
                        if defaults.PFAM_ACCESSIONS
                        else [])
        output:
            parquet=HMM_PQ
        params:
            settings=tracked('hmmer'),
            hmm_db_flag=('--hmm-db ' + str(HMMER_SUBSET_HMM)
                         if defaults.PFAM_ACCESSIONS
                         else '')
        threads:
            workflow.cores
        log:
            job_log('hmmer_species', 'query_label', 'species')
        benchmark:
            job_benchmark('hmmer_species', 'query_label', 'species')
        shell:
            '''
            (
            python scripts/hmmer.py \
                --species {wildcards.species} \
                --threads {threads} \
                {params.hmm_db_flag} \
                {input.parquet:q} \
                {input.pfam_hmm:q} \
                {output.parquet:q}
            ) > {log:q} 2>&1
            '''

