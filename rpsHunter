#!/usr/bin/env python3
"""rpsHunter's command line. Everything it does is in workflow/scripts/launcher.py."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "workflow" / "scripts"))

